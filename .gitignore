# env / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
# scratch + raw outputs (final traces are tracked; scratch is not)
traces/scratch_*
*.out
nohup.out
# secrets / local config
.env
*.key
*.pem
*token*
# bulky or machine-specific
*.safetensors
*.gguf
*.bin
.claude/
worlds/distractors_raw/
# generated training records / checkpoints (reproducible from training/*.py + the small verified source files)
training/data/mcp_router_*.jsonl
training/ckpt/
training/data/*.out
training/data/*.pid
release/datasets/*/data/
release/datasets/*/traces/
release/**/*.gguf
release/*.log

# local-only notes and machine/ops files (kept on disk, not pushed)
*.pid
*.log
traces/regression/pid
traces/p11n_rerun.json
training/data/start_after.txt
# docs/: only the experiment record is public; everything else stays local
docs/*
!docs/EXPERIMENT_LOG.md
!docs/PREREG.md
!docs/RESULTS_SUMMARY.md
